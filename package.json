{
  "name": "@rheactor/rheactor-oxc-config",
  "version": "1.0.0",
  "description": "Rheactor Oxc Config.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#fixtures/*": "./fixtures/*",
    "#oxfmt.config.ts": "./oxfmt.config.ts",
    "#oxlint.config.ts": "./oxlint.config.ts"
  },
  "exports": {
    "./oxfmt": {
      "types": "./dist/oxfmt.d.mts",
      "default": "./dist/oxfmt.mjs"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.mts",
      "default": "./dist/oxlint.mjs"
    }
  },
  "scripts": {
    "build": "bun run lint && tsdown",
    "lint": "bun run typecheck && bun run oxlint && bun run oxfmt",
    "lint:fix": "bun run typecheck && bun run oxlint:fix && bun run oxfmt:fix",
    "oxfmt": "oxfmt --check ./src ./fixtures",
    "oxfmt:fix": "oxfmt --write ./src ./fixtures",
    "oxlint": "oxlint ./src ./fixtures",
    "oxlint:debug": "oxlint --fix ./src ./fixtures --debug timings",
    "oxlint:fix": "oxlint --fix ./src ./fixtures",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
