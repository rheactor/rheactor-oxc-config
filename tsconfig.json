{
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node", "react"],

    "paths": {
      "#/*": ["./src/*"],
      "#fixtures/*": ["./fixtures/*"],
      "#oxfmt.config.ts": ["./oxfmt.config.ts"],
      "#oxlint.config.ts": ["./oxlint.config.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "fixtures/**/*.ts",
    "fixtures/**/*.tsx",
    "oxfmt.config.ts",
    "oxlint.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
